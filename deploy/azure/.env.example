# Azure Container Apps deployment for Odyssey
# Copy to .env and fill in. Never commit .env or real secrets.

AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=westeurope
RESOURCE_GROUP_NAME=pse-aeltai-aks-rg25
AKS_CLUSTER_NAME=pse-aeltai-aks25

# Service principal (optional, uses current az login by default)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Container registry
ACR_NAME=

# Container app settings
CONTAINERAPP_NAME=odyssey-app
CONTAINERAPP_ENV=odyssey-env
IMAGE_NAME=odyssey
IMAGE_TAG=latest
